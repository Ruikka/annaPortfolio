---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Anna Ruikka | Home">
	<section class="flex flex-col items-center gap-8 text-center sm:flex-row sm:items-center sm:gap-10 sm:text-left">
		<img
			src="/profile_picture.JPG"
			alt="Portrait of Anna Ruikka"
			class="h-40 w-40 shrink-0 rounded-full object-cover ring-1 ring-slate-200 sm:h-48 sm:w-48"
		/>
		<div>
			<p class="text-sm font-medium uppercase tracking-wide text-slate-500">Hello world!</p>
			<h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
				Hi, I'm Anna.
			</h1>
			<p class="mt-4 max-w-xl text-slate-600">
				Short bio placeholder — a couple of sentences about who I am, what I do, and what
				I'm looking for next will go here.
			</p>

			<div class="mt-6 flex flex-col gap-1 text-sm text-slate-600 sm:flex-row sm:gap-6">
				<a href="mailto:anna.ruikka@example.com" class="hover:text-slate-900">
					anna.ruikka@example.com
				</a>
				<a href="https://www.linkedin.com" class="hover:text-slate-900">LinkedIn</a>
				<a href="https://github.com" class="hover:text-slate-900">GitHub</a>
			</div>
		</div>
	</section>
</Layout>
