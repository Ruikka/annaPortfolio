---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const { title = "Anna Ruikka", description = "Portfolio of Anna Ruikka" } = Astro.props;

const navLinks = [
	{ href: "/", label: "Home" },
	{ href: "/work", label: "Work Experience" },
	{ href: "/academia", label: "Academia" },
	{ href: "/fun", label: "Fun" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-white text-slate-800">
		<header class="border-b border-slate-200">
			<nav class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6">
				<a href="/" class="text-lg font-semibold tracking-tight text-slate-900">
					Anna Ruikka
				</a>
				<ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm sm:gap-x-6">
					{navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={isActive(link.href) ? "page" : undefined}
								class:list={[
									"transition-colors hover:text-slate-900",
									isActive(link.href)
										? "font-medium text-slate-900 underline underline-offset-4"
										: "text-slate-500",
								]}
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</header>

		<main class="mx-auto w-full max-w-4xl flex-1 px-4 py-10 sm:px-6 sm:py-14">
			<slot />
		</main>

		<footer class="border-t border-slate-200">
			<div class="mx-auto flex max-w-4xl flex-col items-center gap-2 px-4 py-6 text-sm text-slate-500 sm:flex-row sm:justify-between sm:px-6">
				<p>&copy; {new Date().getFullYear()} Anna Ruikka. All rights reserved.</p>
				<p class="flex gap-4">
					<a href="mailto:anna.ruikka@example.com" class="hover:text-slate-800">Email</a>
					<a href="https://www.linkedin.com" class="hover:text-slate-800">LinkedIn</a>
					<a href="https://github.com" class="hover:text-slate-800">GitHub</a>
				</p>
			</div>
		</footer>
	</body>
</html>
